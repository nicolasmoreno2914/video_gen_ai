# Environment files — NEVER commit secrets
.env
.env.local
.env.staging
.env.production
.env.*.local
*.env
# Allow frontend .env.production (contains only public/anon keys)
!frontend/.env.production

# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
build/
.next/

# TypeScript compilation
*.tsbuildinfo

# Video files — generated output
*.mp4
*.mp3
*.wav
*.webm
*.avi
*.mov

# Temporary / runtime storage
tmp/
/tmp/video-engine/
**/logs/

# Render / ffmpeg temp files
*.concat
*.list
scene_*.mp4

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Docker
.dockerignore

# Secrets & keys
*.pem
*.key
*.p12
serviceAccountKey.json
credentials.json

# Coverage
coverage/

# Docs — generated artifacts and utility scripts
# NOTE: backend/.env.production and backend/.env.staging are already covered above
# by the .env.production / .env.staging patterns (git matches them tree-wide).
# If they were ever accidentally committed, remove them with:
#   git rm --cached backend/.env.production backend/.env.staging
*.pdf
docs/*.py

# Rogue env copies (e.g. backend/_env — no dot prefix, no extension)
backend/_env
_env
