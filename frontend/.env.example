# ============================================================
# Video Engine IA — Frontend Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# Backend API base URL
# Local: http://localhost:3500
# Staging: https://your-backend.onrender.com
VITE_API_URL=http://localhost:3500

# Static API secret — only used as fallback when SKIP_AUTH=true (dev only)
VITE_API_SECRET=change_me_in_production

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# Set to true for local dev without Supabase auth
VITE_SKIP_AUTH=false
